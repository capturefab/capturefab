  "scientific_rules": [
    "native driver-scaled F64 bytes are authoritative, including signed zero/subnormal/NaN payload",
    "no host sensitivity division/integration/differentiation/unit conversion/clipping/calibration",
    "same native words remain identical under differing output/sensitivity units",
    "request units and sensitivity units are independent",
    "no sensor source_time or fresh/simultaneous physical conversion inference",
    "all finite new sensitivity values including negative and signed zero are software-admitted; native rejection remains original",
    "old acceleration positive sensitivity rule is unchanged",
    "I/E excitation amounts finite positive; None finite nonnegative including signed zero; mandatory unchanged amount",
    "AC Hz finite positive for every source including None; no zero/default or ignored-slot inference",
    "None/Stop/Clear do not prove physical power-off; ordinary excitation can energize/persist"
  ],
  "admission": {
    "required": "closed typed channels, exact fields under accepted contract; no duplicate/unknown/null/missing before library/task",
    "range": "finite min<max; no additional universal sign bound",
    "sensitivity": "every finite IEEE value for only these five",
    "amount": "I/E >0; None >=0 preserving -0 bits",
    "ac_frequency": "all sources >0",
    "reject": [
      "nonfinite request fields",
      "equal/reversed ranges",
      "null coupling, or missing/null required terminal/scientific field; omitted coupling is allowed",
      "extra excitation on charge",
      "extra terminal on LVDT/RVDT",
      "I/E zero or negative amount",
      "None negative amount",
      "AC zero/-0/negative/nonfinite Hz"
    ]
  },
  "status_controls": {
    "negative_valid_prefix": {
      "status": -200284,
      "actual_per_channel": 1,
      "rule": "publish exact complete one-scan prefix and original native status before deferred lookup"
    },
    "warning": {
      "status": 12345,
      "rule": "raw positive status retained, no data conversion"
    },
    "invalid_geometry": [
      "success or warning actual0 in on_demand => Incomplete with raw status/count",
      "actual<0 or actual>requested => Incomplete; no unqualified bytes"
    ],
    "later_constructor": {
      "status": -990104,
      "rule": "first original error, qualified owned cleanup only, no Start/Read"
    },
    "deferred_hang": "valid prefix and original native code precede optional diagnostic; bounded separate Finish; no native Read in Finish"
  },
  "lifecycle": [
    "resolve eight common + selected AnalogF64/constructor union + only explicit coupling/needed old TC setter before CreateTask",
    "configured constructor order; optional coupling after own constructor before Start",
    "continuous: constructors then clock/buffer/overwrite then exact count/Nth then Start/rate",
    "on_demand: constructors then exact count/Nth then Start; no clock/buffer/overwrite/availability/rate exports",
    "reject actual count/name/order mismatch before allocating/reading",
    "worker host pre-FFI attempt frontier and original D/cutoff; no metadata/poll-based renewal or hard realtime SDK-entry promise",
    "scoped owned cleanup/first cause preserved, no reset/retry/output task"
  ],
  "metadata": {
    "homogeneous": "measurement + requested_not_read_back; ordered channel_measurements with channel_index, actual physical, requested units/science; no per-item measurement/quantity",
    "terminal": "first three request+provenance; default driver_default_unqueried, others explicit_request_not_read_back; no LVDT/RVDT terminal",
    "coupling": "omitted driver_default_unqueried with no request; explicit request + explicit_request_not_read_back",
    "mixed": "measurement:mixed; column measurement/quantity/units once; finite key follows column; no per-word tags/global units"
  },
